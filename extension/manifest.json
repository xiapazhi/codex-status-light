{
  "manifest_version": 3,
  "key": "",
  "name": "StatusLight Web Companion",
  "version": "0.1.0",
  "description": "Sends ChatGPT task status to the local StatusLight application.",
  "minimum_chrome_version": "132",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/conversation-identity.js",
        "content/state-detector.js",
        "content/lifecycle.js",
        "content/chatgpt-observer.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "incognito": "not_allowed"
}
